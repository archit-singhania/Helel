{
  "schemaVersion": 1,
  "name": "python-service",
  "detection": [
    "pyproject.toml|requirements.txt"
  ],
  "conventions": [
    "follow existing project structure",
    "change the smallest coherent surface",
    "add or update meaningful tests"
  ],
  "fileBoundaries": [
    "src/**",
    "tests/**",
    "pyproject.toml",
    "requirements.txt"
  ],
  "validation": [
    {
      "program": "python3",
      "args": [
        "-m",
        "unittest",
        "discover"
      ],
      "requiresApproval": true
    }
  ],
  "commonFailures": [
    "import path mismatch",
    "event loop misuse",
    "unbounded input"
  ]
}
