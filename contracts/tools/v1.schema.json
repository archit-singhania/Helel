{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helel.tools.v1",
  "title": "Helel tool request",
  "oneOf": [
    { "type": "object", "required": ["kind", "query", "limit"], "properties": { "kind": { "const": "searchCode" }, "query": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 } }, "additionalProperties": false },
    { "type": "object", "required": ["kind", "path"], "properties": { "kind": { "const": "readFile" }, "path": { "type": "string" } }, "additionalProperties": false },
    { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "inspectGit" } }, "additionalProperties": false },
    { "type": "object", "required": ["kind", "command", "args"], "properties": { "kind": { "const": "runCommand" }, "command": { "type": "string" }, "args": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    { "type": "object", "required": ["kind", "patch", "reverse"], "properties": { "kind": { "const": "applyPatch" }, "patch": { "type": "string" }, "reverse": { "type": "boolean" } }, "additionalProperties": false }
  ]
}
